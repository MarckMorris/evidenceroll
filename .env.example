EVIDENCEROLL_HOME=.evidenceroll
EVIDENCEROLL_POLICY=config/policy.yaml
EVIDENCEROLL_DEFAULT_CHALLENGER=challenger-good
EVIDENCEROLL_HOST=0.0.0.0
EVIDENCEROLL_PORT=8080
# Set in production to make the audit hash chain keyed rather than merely tamper-evident.
EVIDENCEROLL_AUDIT_HMAC_KEY=
# Set to >=5 to enable the in-process reconciliation loop; leave 0 when Argo drives it. Prefer a
# large interval: frequent reconciliation inflates the false-rollback rate (docs/adr/005).
EVIDENCEROLL_RECONCILE_INTERVAL_SECONDS=0
# "background" (default) scores the non-serving model off the response path so a slow or unreachable
# challenger endpoint cannot add latency to champion traffic. "inline" keeps 0.1.0 behavior.
EVIDENCEROLL_SHADOW_SCORING=background
# Thread-pool size for background shadow scoring; irrelevant when EVIDENCEROLL_SHADOW_SCORING=inline.
EVIDENCEROLL_SHADOW_WORKERS=2
